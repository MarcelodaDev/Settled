# Copia este archivo como .env y rellena los valores. .env nunca se sube al repo.

# PayPal sandbox: developer.paypal.com > Apps & Credentials > pestaña Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# IA principal: Groq (console.groq.com/keys), API compatible con OpenAI
IA_URL=https://api.groq.com/openai/v1/chat/completions
IA_API_KEY=
IA_MODELO=openai/gpt-oss-120b

# Alternativa: OpenRouter (openrouter.ai/keys). Se usa si IA_* está vacío.
OPENROUTER_API_KEY=
# Debe ser un modelo con soporte de tool calling
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Opcional: firma de los recordatorios redactados por la IA
FREELANCER_NOMBRE=

# Opcional: números de factura que el panel no debe mostrar, separados por comas
FACTURAS_OCULTAS=

PORT=3000
