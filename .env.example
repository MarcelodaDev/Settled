# Copia este archivo como .env y rellena los valores. .env nunca se sube al repo.

# PayPal sandbox: developer.paypal.com > Apps & Credentials > pestaña Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# OpenRouter: openrouter.ai/keys
OPENROUTER_API_KEY=
# Debe ser un modelo con soporte de tool calling
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Opcional: firma de los recordatorios redactados por la IA
FREELANCER_NOMBRE=

PORT=3000
